exec --no-startup-id ~/.xsessionrc
# exec --no-startup-id xcompmgr -C
exec --no-startup-id feh --bg-scale ~/.config/new-machine-setup/jesus.jpg
exec --no-startup-id greenclip daemon
exec_always --no-startup-id $HOME/.config/polybar/launch.sh
exec_always --no-startup-id "sleep 1 && ~/.local/bin/lid-suspend-sync"
exec_always --no-startup-id "sleep 1 && ~/.local/bin/vpn-sync"
exec_always --no-startup-id "sleep 3 && xset r rate 250 40"
exec_always --no-startup-id setxkbmap -option ctrl:nocaps -layout us

exec --no-startup-id "echo enabled > /sys/bus/usb/devices/*/power/wakeup 2>/dev/null || true"

# Floating dialog size constraints (fixes massive file picker dialogs)
for_window [window_role="GtkFileChooserDialog"] floating enable, resize set 900 700, move position center
for_window [window_type="dialog"] floating enable

# Speedread (RSVP speed reading)
for_window [class="speedread"] fullscreen enable

# Chord detector popup (floating, centered, sticky across workspaces)
for_window [class="chord-detector"] floating enable, resize set 420 580, move position center, sticky enable

# cava visualizer popup (floating, centered, sticky)
for_window [class="cava"] floating enable, resize set 600 300, move position center, sticky enable

# Chord/BPM/key analysis popup (floating, centered, sticky)
for_window [class="chord-analyze"] floating enable, resize set 480 640, move position center, sticky enable

# Guitar tab record/engrave popup (floating, centered, sticky)
for_window [class="guitar-tab"] floating enable, resize set 560 260, move position center, sticky enable

# Clipboard history + emoji popup (floating, centered, sticky, bordered)
for_window [class="clipboard-popup"] floating enable, border pixel 4, resize set 920 620, move position center, sticky enable

# mpv audio popup (floating, centered) — mimeapps default handler for audio files
for_window [class="mpv"] floating enable, resize set 480 320, move position center
