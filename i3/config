# bindsym $mod+Shift+p exec --no-startup-id kitty --class speedread -e ~/.config/scripts/speedread-clipboard

# Desktop sprite toggle (animated on-screen character: wanders/idles/attacks/spins)
bindsym $mod+p exec --no-startup-id ~/.local/bin/sprite-toggle

# Desktop sprite window: float freely, follow across workspaces, no border
for_window [class="desktop-sprite"] floating enable, sticky enable, border none

# Auto-assign applications to specific workspaces
assign [class="google-chrome"] 7
# assign [class="Google-chrome"] 7
# Playwright MCP browser (launched with --class=PlaywrightMCP) lands on ws7, no focus steal
assign [class="PlaywrightMCP"] 7

